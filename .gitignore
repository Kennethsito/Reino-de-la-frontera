# Unity generated folders to ignore
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
ExportedObj/

# Packed Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# Ignore large debug files and sensitive data
*.log
*.tmp
*.bak
*.old
*.orig

# Memory captures and recordings
[Mm]emoryCaptures/
[Rr]ecordings/

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / MonoDevelop / Rider files
.vs/
.gradle/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Meta files generated by Unity
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Compiled builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Uncomment to ignore asset store tools plugin
# /Assets/AssetStoreTools*

# Allow these essential directories
!Assets/
!ProjectSettings/
!Packages/
!Packages/manifest.json
!Packages/packages-lock.json
